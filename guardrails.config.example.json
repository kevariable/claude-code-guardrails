{
  "protected_branches": ["main", "master"],
  "audit_dir": "~/.claude/audit",
  "allowlist_path": "~/.claude-guardrails/mcp-write-allowlist.txt",
  "destructive_commands": [
    {"pattern": "migrate:fresh|db:wipe|migrate:reset", "context": "production|--env=prod", "reason": "Refusing destructive DB command against production."},
    {"pattern": "DROP\\s+(DATABASE|TABLE)", "context": "prod", "reason": "Refusing DROP against a prod target."},
    {"pattern": "terraform\\s+(destroy|apply\\s+-auto-approve)", "context": "prod", "reason": "Refusing unattended terraform against prod."},
    {"pattern": "rm\\s+-rf\\s+(/|~)(\\s|$)", "context": "", "reason": "Refusing rm -rf on / or home."}
  ],
  "mcp": {
    "gated_server_prefixes": ["mcp__your-crm__", "mcp__claude_ai_Slack__", "mcp__trello__"],
    "write_verb_regex": "(^|[_-])(send|set|record|create|update|delete|archive|deliver|enqueue|publish|add|import|mark|push|save|tag|move|schedule|reorder|score|start|run|pull|write|assign|attach|copy|remove|queue|cancel|enrich|deploy|upload|perform|watch|manage|convert)([_-]|$)",
    "audit_all_servers": true
  },
  "formatters": {
    "php": {"root_marker": "vendor/bin/pint", "command": "{root}/vendor/bin/pint {file} --quiet"},
    "py": {"root_marker": "pyproject.toml", "command": "ruff format {file}"},
    "js": {"root_marker": "package.json", "command": "npx --no-install prettier --write {file}"},
    "ts": {"root_marker": "package.json", "command": "npx --no-install prettier --write {file}"},
    "tsx": {"root_marker": "package.json", "command": "npx --no-install prettier --write {file}"}
  },
  "format_exclude_globs": ["*/vendor/*", "*/node_modules/*", "*/storage/framework/*", "*/.venv/*"],
  "push_evidence": {
    "max_tests": 40,
    "test_timeout_seconds": 540,
    "formatter_timeout_seconds": 120,
    "docker_timeout_seconds": 15,
    "docker_bin": "docker"
  },
  "repos": [
    {
      "name": "my-laravel-app",
      "path": "~/code/my-laravel-app",
      "base_ref": "origin/main",
      "app_dir": ".",
      "changed_file_globs": ["**/*.php"],
      "exclude_globs": ["vendor/**", "storage/**"],
      "tests_dir": "tests",
      "test_file_pattern": "{stem}Test.php",
      "formatter_check": "{repo_root}/vendor/bin/pint --test {files}",
      "test_runner": "docker exec {container} php artisan test {files}",
      "container": "my-laravel-app-1"
    },
    {
      "name": "my-python-service",
      "path": "~/code/my-python-service",
      "base_ref": "origin/main",
      "app_dir": ".",
      "changed_file_globs": ["src/**/*.py"],
      "exclude_globs": [".venv/**"],
      "tests_dir": "tests",
      "test_file_pattern": "test_{stem}.py",
      "formatter_check": "ruff format --check {files}",
      "test_runner": "pytest {files}"
    },
    {
      "name": "my-node-app",
      "path": "~/code/my-node-app",
      "base_ref": "origin/main",
      "app_dir": ".",
      "changed_file_globs": ["src/**/*.ts", "src/**/*.tsx"],
      "exclude_globs": ["node_modules/**", "dist/**"],
      "tests_dir": "src",
      "test_file_pattern": "{stem}.test.ts",
      "formatter_check": "npx --no-install prettier --check {files}",
      "test_runner": "npx --no-install vitest run {files}"
    }
  ]
}
